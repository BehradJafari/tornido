# Installed as /etc/tornado/tornado.env by bootstrap-ubuntu.sh.
PORT=8080
SERVER_ADDRESS=127.0.0.1
DB_URL=jdbc:postgresql://127.0.0.1:5432/tornado
DB_USERNAME=tornado
DB_PASSWORD=CHANGE_ME
TORNADO_ADMIN_USERNAME=tornado-admin
TORNADO_ADMIN_PASSWORD=CHANGE_ME
TORNADO_JWT_SECRET=CHANGE_ME_WITH_AT_LEAST_32_RANDOM_CHARACTERS
TORNADO_TOKEN_TTL=12h

SNAPSHOT_INTERVAL=15m
SNAPSHOT_INITIAL_DELAY=10s
GRADING_INTERVAL=1m
CANDLE_INTERVAL=5m
CANDLE_LIMIT=250
BINANCE_REST_URL=https://api.binance.com
BINANCE_WS_URL=wss://stream.binance.com:9443

# JVM memory ceiling; adjust for the VPS size and Excel export workload.
JAVA_OPTS=-Xms256m -Xmx1536m -XX:+UseG1GC -Djava.security.egd=file:/dev/urandom
